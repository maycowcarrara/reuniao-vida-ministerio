{
  "name": "reuniao-vida-ministerio",
  "private": true,
  "version": "5.1.302",
  "type": "module",
  "scripts": {
    "version:patch": "npm version patch --no-git-tag-version",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run new-congregation:check && npm run version:patch && npm run build && firebase deploy --project rvm-sbssc --only hosting",
    "deploy:rules": "npm run new-congregation:check && firebase deploy --project rvm-sbssc --only firestore:rules",
    "deploy:indexes": "npm run new-congregation:check && firebase deploy --project rvm-sbssc --only firestore:indexes",
    "deploy:all": "npm run new-congregation:check && npm run version:patch && npm run build && firebase deploy --project rvm-sbssc",
    "worker:jw:dev": "npx wrangler dev --config workers/jw-proxy/wrangler.jsonc",
    "worker:jw:deploy": "npx wrangler deploy --config workers/jw-proxy/wrangler.jsonc",
    "worker:jw:whoami": "npx wrangler whoami",
    "migrate:auth:dry": "node scripts/firebase-migration/migrate-auth-users.mjs --dry-run",
    "migrate:auth": "node scripts/firebase-migration/migrate-auth-users.mjs --execute --yes",
    "migrate:firestore:dry": "node scripts/firebase-migration/migrate-firestore.mjs --dry-run",
    "migrate:firestore": "node scripts/firebase-migration/migrate-firestore.mjs --execute --yes",
    "migrate:indexes:dry": "node scripts/firebase-migration/migrate-indexes.mjs --dry-run",
    "migrate:indexes": "node scripts/firebase-migration/migrate-indexes.mjs --execute --yes",
    "migrate:verify": "node scripts/firebase-migration/verify-target.mjs",
    "new-congregation:check": "node scripts/firebase-migration/check-new-target.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.18",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "drag-drop-touch": "^1.3.1",
    "firebase": "^12.8.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "^15.22.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.13"
    },
    "@rollup/plugin-terser": {
      "serialize-javascript": "^7.0.5"
    }
  }
}
