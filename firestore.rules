rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function dataOwnerUid() {
      return "P8B0fY6m8JVjoLFGZEcXQ1uWsWs2";
    }

    function primaryOwnerUid() {
      return "P8B0fY6m8JVjoLFGZEcXQ1uWsWs2";
    }

    function isOwnerUser(userId) {
      return isSignedIn()
        && userId == dataOwnerUid()
        && request.auth.uid == primaryOwnerUid();
    }

    function accessConfig(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/configuracoes/acessos);
    }

    function isGrantedUser(userId) {
      return isSignedIn()
        && userId == dataOwnerUid()
        && exists(/databases/$(database)/documents/users/$(userId)/configuracoes/acessos)
        && request.auth.token.email in accessConfig(userId).data.emails;
    }

    function isAccessAdmin(userId) {
      return isOwnerUser(userId) || (
        isGrantedUser(userId)
        && request.auth.token.email in accessConfig(userId).data.get("admins", [])
      );
    }

    function isValidAccessConfig() {
      return request.resource.data.keys().hasOnly(["ownerUid", "emails", "admins", "updatedAtIso"])
        && request.resource.data.ownerUid == primaryOwnerUid()
        && request.resource.data.emails is list
        && request.resource.data.admins is list
        && request.resource.data.emails.size() <= 50
        && request.resource.data.admins.size() <= 50
        && request.resource.data.emails.hasAll(request.resource.data.admins);
    }

    function canManageOwner(userId) {
      return isOwnerUser(userId) || isGrantedUser(userId);
    }

    function isAdminUser(userId) {
      return canManageOwner(userId);
    }

    function isConfirmationStatus(status) {
      return status in ["pendente", "confirmado", "nao_pode"];
    }

    function isWeekReminderStatus(status) {
      return status in ["nao_enviado", "pendente", "confirmado", "imprevisto"];
    }

    function confirmationMutableKeys() {
      return [
        "sentChannels",
        "lastNotificationChannel",
        "lastNotificationSentAt",
        "lastNotificationSentAtIso",
        "lastWhatsappSentAt",
        "lastWhatsappSentAtIso",
        "lastEmailSentAt",
        "lastEmailSentAtIso",
        "status",
        "previousStatus",
        "responseHistory",
        "lastResponseSource",
        "lastResponseActorType",
        "updatedAt",
        "lastResponseAt",
        "lastResponseAtIso",
        "confirmedAt",
        "declinedAt",
        "lastStatusChangeAtIso",
        "lastStatusChangeFrom",
        "lastStatusChangeTo",
        "lastStatusChangeKey",
        "alertPending",
        "alertSeenAt",
        "lastReminderSentAt",
        "lastReminderSentAtIso",
        "weekReminderStatus",
        "weekReminderPreviousStatus",
        "weekReminderHistory",
        "lastWeekReminderSource",
        "lastWeekReminderActorType",
        "weekReminderRespondedAt",
        "weekReminderRespondedAtIso",
        "lastWeekReminderChangeAtIso",
        "lastWeekReminderChangeFrom",
        "lastWeekReminderChangeTo",
        "lastWeekReminderChangeKey",
        "weekReminderAlertPending",
        "weekReminderAlertSeenAt"
      ];
    }

    function confirmationBaseKeys() {
      return [
        "identityVersion", "grupoId", "programacaoId", "tipoReuniao", "slotId", "pessoaId", "papel",
        "token",
        "assignmentKey",
        "ownerUid",
        "lang",
        "semana",
        "dataISO",
        "tituloParte",
        "tituloParteExibicao",
        "pessoaNome",
        "role",
        "congregacaoNome",
        "agendaLink",
        "sala",
        "secao",
        "sentChannels",
        "lastNotificationChannel",
        "lastNotificationSentAt",
        "lastNotificationSentAtIso",
        "lastWhatsappSentAt",
        "lastWhatsappSentAtIso",
        "lastEmailSentAt",
        "lastEmailSentAtIso",
        "status",
        "weekReminderStatus",
        "createdAt",
        "updatedAt",
        "previousStatus",
        "responseHistory",
        "lastResponseSource",
        "lastResponseActorType",
        "lastResponseAt",
        "lastResponseAtIso",
        "confirmedAt",
        "declinedAt",
        "lastStatusChangeAtIso",
        "lastStatusChangeFrom",
        "lastStatusChangeTo",
        "lastStatusChangeKey",
        "alertPending",
        "alertSeenAt",
        "lastReminderSentAt",
        "lastReminderSentAtIso",
        "weekReminderPreviousStatus",
        "weekReminderHistory",
        "lastWeekReminderSource",
        "lastWeekReminderActorType",
        "weekReminderRespondedAt",
        "weekReminderRespondedAtIso",
        "lastWeekReminderChangeAtIso",
        "lastWeekReminderChangeFrom",
        "lastWeekReminderChangeTo",
        "lastWeekReminderChangeKey",
        "weekReminderAlertPending",
        "weekReminderAlertSeenAt",
        "id"
      ];
    }

    function identityFieldsEqual(a, b) {
      return a.get('identityVersion', 1) == b.get('identityVersion', 1)
        && a.get('grupoId', '') == b.get('grupoId', '')
        && a.get('programacaoId', '') == b.get('programacaoId', '')
        && a.get('tipoReuniao', '') == b.get('tipoReuniao', '')
        && a.get('slotId', '') == b.get('slotId', '')
        && a.get('pessoaId', '') == b.get('pessoaId', '')
        && a.get('papel', '') == b.get('papel', '');
    }
    function immutableConfirmation() {
      return request.resource.data.token == resource.data.token
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.assignmentKey == resource.data.assignmentKey
        && identityFieldsEqual(request.resource.data, resource.data)
        && (resource.data.get('identityVersion', 1) != 2 || (
          request.resource.data.diff(resource.data).removedKeys().size() == 0
          && request.resource.data.get('sentChannels', {}).diff(resource.data.get('sentChannels', {})).removedKeys().size() == 0
          && request.resource.data.get('responseHistory', []).size() >= resource.data.get('responseHistory', []).size()
          && request.resource.data.get('weekReminderHistory', []).size() >= resource.data.get('weekReminderHistory', []).size()
        ));
    }
    function validIdentity(data) {
      return (data.get('identityVersion', 1) == 1 && !data.assignmentKey.matches('v2-.*')) || (
        data.identityVersion == 2 && data.grupoId is string && data.grupoId.size() > 0
        && data.programacaoId is string && data.programacaoId.size() > 0
        && data.tipoReuniao in ['meioSemana', 'fimDeSemana']
        && data.slotId is string && data.slotId.size() > 0
        && data.pessoaId is string && data.pessoaId.size() > 0
        && data.papel is string && data.papel.size() > 0
        && data.assignmentKey.matches('v2-[0-9a-f]+')
      );
    }
    function contractConfig(userId) {
      return get(/databases/$(database)/documents/users/$(userId)/configuracoes/geral).data;
    }
    function revisionAdvanced(userId) {
      let before = contractConfig(userId);
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/configuracoes/geral).data;
      return before.get('ativacaoMultiGrupos', {}).get('contrato', 0) == 2
        && before.ativacaoMultiGrupos.status == 'ativa'
        && after.ativacaoMultiGrupos == before.ativacaoMultiGrupos
        && after.revisionProgramacoes == before.revisionProgramacoes + 1;
    }
    function programProtocol(userId) {
      return contractConfig(userId).get('ativacaoMultiGrupos', {}).get('contrato', 0) != 2 || revisionAdvanced(userId);
    }
    function scopedDeletion(userId, docId) {
      let operation = getAfter(/databases/$(database)/documents/users/$(userId)/operacoes_programacao/$(docId)).data;
      return revisionAdvanced(userId) && operation.tipo == 'excluir'
        && operation.programacaoId == docId && operation.ownerUid == userId
        && operation.grupoId == resource.data.grupoId && operation.at == request.time;
    }
    function preservesV2Program() {
      return (resource.data.get('versaoProgramacao', 1) < 2 && !('grupoId' in resource.data)) || (
        request.resource.data.versaoProgramacao == 2
        && request.resource.data.grupoId == resource.data.grupoId
        && request.resource.data.id == resource.data.id
        && request.resource.data.get('identidadeLegada', {}) == resource.data.get('identidadeLegada', {})
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.meioSemana.diff(resource.data.meioSemana).removedKeys().size() == 0
        && request.resource.data.get('fimDeSemana', {}).diff(resource.data.get('fimDeSemana', {})).removedKeys().size() == 0
      );
    }
    function validProgram(docId) {
      return (request.resource.data.get('versaoProgramacao', 1) < 2 && !('grupoId' in request.resource.data)) || (
        request.resource.data.versaoProgramacao == 2 && request.resource.data.id == docId
        && request.resource.data.grupoId is string && request.resource.data.grupoId.size() > 0
        && request.resource.data.meioSemana.ativo is bool
        && request.resource.data.get('fimDeSemana', {'ativo': false}).ativo is bool
        && request.resource.data.publicadaNoQuadro is bool
      );
    }

    function publicConfirmationDoc(token) {
      return get(/databases/$(database)/documents/confirmacoes_publicas/$(token));
    }

    function publicConfirmationAfterDoc(token) {
      return getAfter(/databases/$(database)/documents/confirmacoes_publicas/$(token));
    }

    function publishedConfirmationTarget() {
      return resource.data.get('identityVersion', 1) != 2 || (
        exists(/databases/$(database)/documents/quadros_publicos/$(resource.data.ownerUid))
        && identityFieldsEqual(resource.data,
          get(/databases/$(database)/documents/quadros_publicos/$(resource.data.ownerUid)).data.configuracoes.destinosConfirmacao[resource.data.assignmentKey])
      );
    }

    function matchesPublicConfirmation(userId, assignmentKey) {
      return request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && exists(/databases/$(database)/documents/confirmacoes_publicas/$(request.resource.data.token))
        && publicConfirmationDoc(request.resource.data.token).data.ownerUid == userId
        && publicConfirmationDoc(request.resource.data.token).data.assignmentKey == assignmentKey
        && identityFieldsEqual(request.resource.data, publicConfirmationDoc(request.resource.data.token).data);
    }

    function isValidPublicConfirmationMirrorUpdate(userId, assignmentKey) {
      return immutableConfirmation() && publishedConfirmationTarget() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(confirmationMutableKeys())
        && request.resource.data.token == resource.data.token
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.assignmentKey == resource.data.assignmentKey
        && matchesPublicConfirmation(userId, assignmentKey)
        && isConfirmationStatus(request.resource.data.status)
        && isWeekReminderStatus(request.resource.data.weekReminderStatus);
    }

    function isValidPublicConfirmationUpdate() {
      return immutableConfirmation() && publishedConfirmationTarget() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(confirmationMutableKeys())
        && request.resource.data.token == resource.data.token
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.assignmentKey == resource.data.assignmentKey
        && request.resource.data.pessoaNome == resource.data.pessoaNome
        && request.resource.data.tituloParte == resource.data.tituloParte
        && isConfirmationStatus(request.resource.data.status)
        && isWeekReminderStatus(request.resource.data.weekReminderStatus);
    }

    function isValidNotificationCreate() {
      return request.resource.data.keys().hasOnly([
        "id",
        "ownerUid",
        "type",
        "title",
        "description",
        "token",
        "assignmentKey",
        "dataISO",
        "semana",
        "pessoaNome",
        "status",
        "previousStatus",
        "meta",
        "readAt",
        "readAtIso",
        "createdAt",
        "createdAtIso"
      ])
      && request.resource.data.token is string
      && request.resource.data.token.size() > 0
      && request.resource.data.id is string
      && request.resource.data.id.size() > 0
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 120
      && request.resource.data.description is string
      && request.resource.data.description.size() <= 500
      && request.resource.data.createdAt == request.time
      && request.resource.data.createdAtIso is string
      && request.resource.data.createdAtIso.size() <= 40
      && request.resource.data.readAt == null
      && request.resource.data.readAtIso == null
      && request.resource.data.meta is map
      && identityFieldsEqual(request.resource.data.meta, publicConfirmationAfterDoc(request.resource.data.token).data)
      && request.resource.data.meta.keys().hasOnly([
        "tituloParte",
        "congregacaoNome", "identityVersion", "grupoId", "programacaoId", "tipoReuniao", "slotId", "pessoaId", "papel"
      ])
      && exists(/databases/$(database)/documents/confirmacoes_publicas/$(request.resource.data.token))
      && publicConfirmationAfterDoc(request.resource.data.token).data.ownerUid == request.resource.data.ownerUid
      && publicConfirmationAfterDoc(request.resource.data.token).data.assignmentKey == request.resource.data.assignmentKey
      && publicConfirmationAfterDoc(request.resource.data.token).data.dataISO == request.resource.data.dataISO
      && publicConfirmationAfterDoc(request.resource.data.token).data.semana == request.resource.data.semana
      && publicConfirmationAfterDoc(request.resource.data.token).data.pessoaNome == request.resource.data.pessoaNome
      && request.resource.data.type in ["confirmacao_status", "lembrete_semana_status"]
      && (
        (
          request.resource.data.type == "confirmacao_status"
          && publicConfirmationAfterDoc(request.resource.data.token).data.lastStatusChangeKey is string
          && publicConfirmationAfterDoc(request.resource.data.token).data.lastStatusChangeKey.size() > 0
          && request.resource.data.status == publicConfirmationAfterDoc(request.resource.data.token).data.status
          && request.resource.data.previousStatus == publicConfirmationAfterDoc(request.resource.data.token).data.previousStatus
          && request.resource.data.id == request.resource.data.token + "_confirmacao_status_" + publicConfirmationAfterDoc(request.resource.data.token).data.lastStatusChangeKey
        )
        || (
          request.resource.data.type == "lembrete_semana_status"
          && publicConfirmationAfterDoc(request.resource.data.token).data.lastWeekReminderChangeKey is string
          && publicConfirmationAfterDoc(request.resource.data.token).data.lastWeekReminderChangeKey.size() > 0
          && request.resource.data.status == publicConfirmationAfterDoc(request.resource.data.token).data.weekReminderStatus
          && request.resource.data.previousStatus == publicConfirmationAfterDoc(request.resource.data.token).data.weekReminderPreviousStatus
          && request.resource.data.id == request.resource.data.token + "_lembrete_semana_status_" + publicConfirmationAfterDoc(request.resource.data.token).data.lastWeekReminderChangeKey
        )
      );
    }

    match /users/{userId}/configuracoes/{docId} {
      allow get: if canManageOwner(userId);
      allow list: if false;
      allow write: if (
          docId == "acessos"
          && isOwnerUser(userId)
          && isValidAccessConfig()
        ) || (
          docId == "acessos"
          && isAccessAdmin(userId)
          && isValidAccessConfig()
          && request.resource.data.admins == resource.data.get("admins", [])
        ) || (
          docId != "acessos"
          && isAdminUser(userId)
          && (resource == null || resource.data.get('versaoProgramacao', 1) < 2 || (
            request.resource.data.versaoProgramacao == resource.data.versaoProgramacao
            && request.resource.data.grupoLegadoId == resource.data.grupoLegadoId
            && request.resource.data.diff(resource.data).removedKeys().size() == 0
            && request.resource.data.grupos.diff(resource.data.grupos).removedKeys().size() == 0
            && (resource.data.get('ativacaoMultiGrupos', {}).get('contrato', 0) != 2 || (
              request.resource.data.ativacaoMultiGrupos == resource.data.ativacaoMultiGrupos
              && resource.data.ativacaoMultiGrupos.status == 'ativa'
              && request.resource.data.revisionProgramacoes == resource.data.revisionProgramacoes + 1
            ))
          ))
        );
    }

    match /users/{userId}/programacao/{docId} {
      allow read: if isAdminUser(userId);
      allow create: if isAdminUser(userId) && validProgram(docId) && programProtocol(userId);
      allow update: if isAdminUser(userId) && validProgram(docId) && preservesV2Program() && programProtocol(userId);
      allow delete: if isAdminUser(userId) && (
        (resource.data.get('versaoProgramacao', 1) < 2 && !('grupoId' in resource.data))
        || scopedDeletion(userId, docId));
    }
    match /users/{userId}/operacoes_programacao/{docId} {
      allow read: if isAdminUser(userId);
      allow create, update: if isAdminUser(userId) && revisionAdvanced(userId)
        && request.resource.data.keys().hasOnly(['versaoProgramacao', 'ownerUid', 'grupoId', 'programacaoId', 'tipo', 'at'])
        && request.resource.data.ownerUid == userId && request.resource.data.programacaoId == docId
        && request.resource.data.tipo == 'excluir' && request.resource.data.at == request.time;
    }

    match /users/{userId}/alunos/{docId} {
      allow read, create, delete: if isAdminUser(userId);
      allow update: if isAdminUser(userId) && (!('gruposParticipantes' in resource.data)
        || (request.resource.data.gruposParticipantes is list && request.resource.data.diff(resource.data).removedKeys().size() == 0));
    }

    match /users/{userId}/confirmacoes/{assignmentKey} {
      allow read: if isAdminUser(userId);
      allow create: if isAdminUser(userId)
        && validIdentity(request.resource.data)
        && request.resource.data.keys().hasOnly(confirmationBaseKeys())
        && request.resource.data.ownerUid == userId
        && request.resource.data.assignmentKey == assignmentKey
        && isConfirmationStatus(request.resource.data.status)
        && isWeekReminderStatus(request.resource.data.weekReminderStatus);
      allow update: if (isAdminUser(userId) && immutableConfirmation() && validIdentity(request.resource.data))
        || isValidPublicConfirmationMirrorUpdate(userId, assignmentKey);
      allow delete: if isAdminUser(userId);
    }

    match /confirmacoes_publicas/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && canManageOwner(request.resource.data.ownerUid)
        && validIdentity(request.resource.data)
        && request.resource.data.token == token
        && request.resource.data.keys().hasOnly(confirmationBaseKeys())
        && isConfirmationStatus(request.resource.data.status)
        && isWeekReminderStatus(request.resource.data.weekReminderStatus);
      allow update: if (
          canManageOwner(resource.data.ownerUid) && immutableConfirmation() && validIdentity(request.resource.data)
        ) || isValidPublicConfirmationUpdate();
      allow delete: if canManageOwner(resource.data.ownerUid);
    }

    match /quadros_publicos/{userId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdminUser(userId)
        && request.resource.data.ownerUid == userId
        && (contractConfig(userId).get('ativacaoMultiGrupos', {}).get('contrato', 0) != 2 || (
          request.resource.data.configuracoes.publicacaoContrato == 2
          && request.resource.data.configuracoes.revisionProgramacoes == contractConfig(userId).revisionProgramacoes
          && request.resource.data.configuracoes.keys().hasOnly(['nome_cong', 'idioma', 'dia_reuniao', 'horario', 'dia_reuniao_fds', 'horario_fds', 'grupoLegadoId', 'grupoPrincipalId', 'versaoProgramacao', 'publicacaoContrato', 'revisionProgramacoes', 'grupos', 'destinosConfirmacao'])
        ))
        && request.resource.data.keys().hasOnly([
          "ownerUid",
          "updatedAtIso",
          "configuracoes",
          "historico_reunioes"
        ]);
    }

    match /notificacoes/{notificationId} {
      allow read: if canManageOwner(resource.data.ownerUid);

      allow create: if request.resource.data.id == notificationId
        && (
          canManageOwner(request.resource.data.ownerUid)
          || isValidNotificationCreate()
        );

      allow update: if canManageOwner(resource.data.ownerUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "readAt",
          "readAtIso"
        ]);

      allow delete: if canManageOwner(resource.data.ownerUid);
    }
  }
}
