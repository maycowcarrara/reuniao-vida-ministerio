# Copie este arquivo para .env.local e preencha com os dados do novo projeto.
# As variaveis VITE_* entram no bundle do navegador; nao coloque segredos aqui.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rvm-sbssc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rvm-sbssc
VITE_FIREBASE_STORAGE_BUCKET=rvm-sbssc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UID onde os dados da congregacao ficam salvos em users/{uid}.
VITE_ADMIN_UID=

# UID/email da conta principal que podera gerenciar acessos.
# Para uma congregacao nova com uma unica conta, pode ser igual ao VITE_ADMIN_UID.
VITE_OWNER_UID=
VITE_OWNER_EMAIL=

# EmailJS e opcional. Deixe vazio se nao for usar envio automatico por e-mail.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Proxy JW e opcional, mas melhora a importacao automatica da programacao.
VITE_JW_PROXY_URL=https://proxy-jw-congregacao.espanhola-sul-sbs.workers.dev
VITE_JW_PROXY_FALLBACKS=https://corsproxy.io/?{url},https://api.allorigins.win/raw?url={url},https://r.jina.ai/http://{targetHostPath}
